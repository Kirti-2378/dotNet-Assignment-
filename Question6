using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter the value of N: ");
        int n = Convert.ToInt32(Console.ReadLine());

        Console.WriteLine("\nEven Numbers:");
        for (int i = 1; i <= n; i++)
        {
            if (i % 2 == 0)
            {
                Console.Write(i + " ");
            }
        }

        Console.WriteLine("\n\nOdd Numbers:");
        for (int i = 1; i <= n; i++)
        {
            if (i % 2 != 0)
            {
                Console.Write(i + " ");
            }
        }
    }
}
