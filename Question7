using System;

class Question7
{
    static void Main5()
    {
        Console.Write("Enter a positive integer: ");
        int num = Convert.ToInt32(Console.ReadLine());

        long factorial = 1;

        for (int i = 1; i <= num; i++)
        {
            factorial = factorial * i;
        }

        Console.WriteLine("Factorial of " + num + " is: " + factorial);
    }
}
